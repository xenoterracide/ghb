{
  "name": "ghb",
  "packageManager": "pnpm@12.18.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "git-conventional-commits": "^2.8.0",
    "lint-staged": "^17.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.5",
    "prettier-plugin-properties": "^0.3.0",
    "prettier-plugin-toml": "^4.0.0",
    "@eslint/js": "^10.0.0",
    "@eslint/json": "^2.0.0",
    "@eslint/markdown": "^8.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "jiti": "^2.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "check": "pnpm lint:prettier && pnpm lint:eslint && pnpm typecheck && pnpm test",
    "contribute": "sh .config/git/hooks/heal.sh",
    "ghb": "pnpm --filter @xenoterracide/ghb run ghb",
    "lint:prettier": "prettier --ignore-unknown --cache --check '**'",
    "lint:reuse": "pnpm reuse download --all && pnpm reuse lint",
    "lint:eslint": "eslint .",
    "lint": "pnpm lint:eslint && pnpm lint:prettier && pnpm lint:reuse",
    "precontribute": "pnpm setup:corepack",
    "reuse": "uv run --frozen --group dev reuse",
    "secrets": "pnpm --filter @xenoterracide/ghb run ghb secrets",
    "setup:corepack": "npm install --global corepack && corepack enable --install-directory ~/.local/bin",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json && pnpm -r run typecheck",
    "test": "vitest run --coverage"
  }
}
