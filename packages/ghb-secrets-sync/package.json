{
  "name": "@xenoterracide/ghb-secrets-sync",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "packageManager": "yarn@4.17.0",
  "main": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "clipanion": "^4.0.0-rc.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xenoterracide/ghb.git",
    "directory": "packages/ghb-secrets-sync"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "yarn build",
    "secrets-sync": "tsx src/cli.ts",
    "test": "vitest run && yarn typecheck",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  }
}
