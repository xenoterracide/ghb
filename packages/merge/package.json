{
  "name": "@xenoterracide/merge",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "packageManager": "yarn@4.16.0",
  "bin": "dist/merge.js",
  "main": "dist/merge.js",
  "types": "dist/merge.d.ts",
  "exports": {
    ".": {
      "types": "./dist/merge.d.ts",
      "default": "./dist/merge.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "clipanion": "^4.0.0-rc.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xenoterracide/ts-cli-devtools.git",
    "directory": "packages/merge"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "yarn build",
    "merge:copilot": "tsx merge.ts --engine copilot",
    "merge:junie": "tsx merge.ts --engine junie",
    "merge:kimi": "tsx merge.ts --engine kimi",
    "test": "vitest run && yarn typecheck",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  }
}
