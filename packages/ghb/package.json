{
  "name": "@xenoterracide/ghb",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "packageManager": "yarn@4.17.1",
  "bin": "dist/cli.js",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@xenoterracide/ghb-merge": "workspace:^",
    "@xenoterracide/ghb-secrets-sync": "workspace:^",
    "clipanion": "^4.0.0-rc.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xenoterracide/ghb.git",
    "directory": "packages/ghb"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "yarn build",
    "ghb": "tsx src/cli.ts",
    "test": "vitest run && yarn typecheck",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  }
}
