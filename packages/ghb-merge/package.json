{
  "name": "@xenoterracide/ghb-merge",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "packageManager": "yarn@4.17.0",
  "main": "merge.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/merge.js",
    "types": "dist/merge.d.ts",
    "exports": {
      ".": {
        "types": "./dist/merge.d.ts",
        "default": "./dist/merge.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0",
    "ai": "^6.0.0",
    "clipanion": "^4.0.0-rc.4",
    "smol-toml": "^1.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xenoterracide/ghb.git",
    "directory": "packages/ghb-merge"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "yarn build",
    "merge:copilot": "tsx merge.ts --copilot",
    "merge:junie": "tsx merge.ts --junie",
    "merge:kimi": "tsx merge.ts --kimi",
    "test": "vitest run && yarn typecheck",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  }
}
